# Telegram
BOT_TOKEN=123456789:telegram_bot_token

# Docker image target:
# runtime      — yt-dlp, ffmpeg and local Whisper
# runtime-lite — yt-dlp and ffmpeg without the large Whisper/PyTorch layer
DOCKER_TARGET=runtime

# Optional permanent HTTPS URL. If empty, Compose uses Cloudflare Quick Tunnel.
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBAPP_URL_FILE=/tunnel/url.txt

# Instagram Apify fallback (used only when the public page hides media)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=elis~instagram-downloader-api

# Donations
KOFI_URL=

# Link moderation and downloader limits
ALLOWED_LINKS_FILE=/app/data/allowed-links.json
REDDIT_USER_AGENT=linux:cattemis-bot:2.0
YTDLP_PATH=yt-dlp
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
MAX_MEDIA_ITEMS=50
MAX_FILE_SIZE=52428800
RETRY_ATTEMPTS=3
RETRY_DELAY=1.2
ADMIN_CACHE_TTL=60

# OpenAI/OpenRouter-compatible LLM
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_SYSTEM_PROMPT=
LLM_COOLDOWN_SECONDS=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=480
LLM_TEMPERATURE=0.6
LLM_MAX_HISTORY_MESSAGES=8
LLM_TIMEZONE=Asia/Almaty
LLM_WEB_SEARCH_ENABLED=false
LLM_WEB_SEARCH_MAX_RESULTS=5
LLM_VISION_ENABLED=true
LLM_VIDEO_FRAME_COUNT=3

# Local OpenAI Whisper CLI
WHISPER_ENABLED=false
WHISPER_PATH=whisper
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=auto
